# ==============================================================================
# GRIDGUARD NEXUS X - Monorepo Environment Configuration Template
# ==============================================================================

# Backend Settings
PROJECT_NAME="GRIDGUARD NEXUS X"
PROJECT_VERSION="1.0.0-level1"
STAGE="LEVEL 1: PROJECT FOUNDATION"
ENVIRONMENT="development"
DEBUG=true

HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Storage Connection
# DATABASE_URL="postgresql+psycopg://postgres:postgrespassword@localhost:5432/gridguard_nexus"
DATABASE_URL=
DATABASE_DEV_FALLBACK_SQLITE=true
DATABASE_TIMEOUT_SECONDS=5

SECRET_KEY="replace-this-dev-token-in-production-deployments"

# Frontend Public Settings
NEXT_PUBLIC_API_URL="http://localhost:8000"
