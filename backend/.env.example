# ==============================================================================
# GRIDGUARD NEXUS X - Backend Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Project Metadata
PROJECT_NAME="GRIDGUARD NEXUS X"
PROJECT_VERSION="1.0.0-level1"
STAGE="LEVEL 1: PROJECT FOUNDATION"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Persistent Database Configuration
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
# Example for local PostgreSQL or Docker:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/gridguard_nexus"
# If left blank, defaults to local SQLite dev fallback (gridguard_dev.db) for offline development:
DATABASE_URL=
DATABASE_DEV_FALLBACK_SQLITE=true
DATABASE_TIMEOUT_SECONDS=5

# Security
SECRET_KEY="replace-with-a-secure-random-token-in-production"
